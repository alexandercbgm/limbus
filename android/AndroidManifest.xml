<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.github.alexandercbgm.limbus" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />
  <application android:label="Limbus" android:icon="@mipmap/ic_launcher" android:hardwareAccelerated="true" android:theme="@style/Fullscreen"
    android:appCategory="game" android:isGame="true" android:enableOnBackInvokedCallback="true">
    <!-- Android 16 turns big screens' apps to any orientation; the game is drawn for landscape, so it keeps that while it may -->
    <property android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY" android:value="true" />
    <activity android:name="com.limbus.game.MainActivity" android:exported="true" android:screenOrientation="sensorLandscape"
      android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density" android:launchMode="singleTask">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
